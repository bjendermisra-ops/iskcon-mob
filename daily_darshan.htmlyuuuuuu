<!DOCTYPE html>
<html lang="hi"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#FF9933">
<meta name="robots" content="noindex">
<title>Kaam Chal Raha Hai 🚧</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800&family=Noto+Sans+Devanagari:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--sky1:#FFE0B2;--sky2:#FFB74D;--t:#4E2A00;--card:rgba(255,255,255,.72);--acc:#E65100;--gold:#FFC107}
[data-theme=dark]{--sky1:#1a1033;--sky2:#3b1d5a;--t:#fdebd0;--card:rgba(20,12,35,.65);--acc:#FFB74D}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;min-height:100%}
body{font-family:Poppins,'Noto Sans Devanagari',system-ui,sans-serif;color:var(--t);background:linear-gradient(180deg,var(--sky1),var(--sky2));min-height:100vh;min-height:100dvh;overflow-x:hidden;padding:calc(16px + env(safe-area-inset-top,0px)) 16px calc(24px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;align-items:center}
.wrap{width:100%;max-width:480px;text-align:center}
.big{display:flex;justify-content:center;align-items:center;gap:6px;font-weight:800;font-size:4.6rem;line-height:1;margin:6px 0 0;color:var(--acc);text-shadow:0 4px 0 rgba(0,0,0,.12)}
.chakra{width:4.1rem;height:4.1rem;border-radius:50%;border:.5rem dashed var(--gold);position:relative;animation:spin 6s linear infinite;box-shadow:0 0 22px rgba(255,193,7,.7)}
.chakra:after{content:"🪷";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:1.7rem;animation:spin 6s linear infinite reverse}
@keyframes spin{to{transform:rotate(360deg)}}
h1{font-size:1.15rem;margin:8px 0 2px;font-weight:800}
.msg{min-height:2.6em;font-size:.88rem;font-weight:600;opacity:.92;transition:opacity .4s}
canvas{display:block;width:100%;margin:8px auto 0;border-radius:24px;box-shadow:0 10px 24px rgba(0,0,0,.22);touch-action:manipulation;-webkit-user-select:none;user-select:none;cursor:pointer}
.bar{height:16px;border-radius:12px;background:rgba(0,0,0,.14);overflow:hidden;margin:14px 6px 4px;border:2px solid rgba(0,0,0,.12)}
.bar i{display:block;height:100%;width:0;border-radius:10px;background:repeating-linear-gradient(45deg,#FFC107 0 12px,#37474F 12px 24px);background-size:34px 34px;animation:fill 5s ease-out forwards,stripes 1s linear infinite}
@keyframes fill{to{width:99%}}
@keyframes stripes{to{background-position:34px 0}}
.pt{font-size:.74rem;font-weight:700;opacity:.85}
.card{margin:16px 0 12px;background:var(--card);border-radius:22px;padding:14px;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.35)}
.card h2{margin:0 0 2px;font-size:.92rem;font-weight:800}
.card p{margin:0 0 8px;font-size:.74rem;opacity:.85}
.jap{position:relative;width:132px;height:132px;margin:2px auto}
.jap svg{width:100%;height:100%;transform:rotate(-90deg)}
.jap circle{fill:none;stroke-width:9}
.jap .tr{stroke:rgba(0,0,0,.12)}
.jap .pr{stroke:var(--acc);stroke-linecap:round;stroke-dasharray:326.7;stroke-dashoffset:326.7;transition:stroke-dashoffset .25s}
.jb{position:absolute;inset:16px;border-radius:50%;border:0;background:linear-gradient(135deg,#FF9933,#E65100);color:#fff;font-family:inherit;font-weight:800;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 6px 16px rgba(230,81,0,.45)}
.jb:active{transform:scale(.93)}
.jb b{font-size:1.7rem;line-height:1}.jb small{font-size:.6rem;font-weight:700;margin-top:2px}
.mala{font-size:.74rem;font-weight:700;margin-top:6px}
.btns{display:flex;gap:10px;margin-top:6px}
.btns a,.btns button{flex:1;padding:13px 8px;border-radius:14px;border:0;font-family:inherit;font-weight:800;font-size:.84rem;text-decoration:none;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px}
.home{background:linear-gradient(135deg,#00897B,#26A69A);color:#fff}
.retry{background:var(--card);color:var(--t);border:1px solid rgba(0,0,0,.15)!important}
.foot{margin-top:14px;font-size:.7rem;opacity:.75;font-weight:600}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,40px);background:#166534;color:#fff;padding:12px 18px;border-radius:30px;font-weight:700;font-size:.82rem;opacity:0;transition:.35s;z-index:9;max-width:92%;text-align:center;pointer-events:none}
.toast.on{opacity:1;transform:translate(-50%,0)}
.float{position:fixed;pointer-events:none;font-size:1.1rem;animation:up 1.1s ease-out forwards;z-index:8}
@keyframes up{to{transform:translateY(-70px);opacity:0}}
@media (prefers-reduced-motion:reduce){.chakra,.chakra:after,.bar i{animation-duration:.01s!important;animation-iteration-count:1!important}}
</style></head>
<body>
<div class="wrap">
<div class="big"><span>4</span><span class="chakra"></span><span>4</span></div>
<h1>Kaam chal raha hai, Prabhu! 🚧</h1>
<div class="msg" id="m"></div>
<canvas id="cv" width="640" height="480" aria-label="Mandir nirman ka animation"></canvas>
<div class="bar"><i></i></div>
<div class="pt" id="pt">Loading... 99% (itna hi rehta hai 😅)</div>

<div class="card">
<h2>📿 Tab tak ek mala jap lo!</h2>
<p>Beads tap karo. 108 ho gaye to mala poori.</p>
<div class="jap"><svg viewBox="0 0 120 120"><circle class="tr" cx="60" cy="60" r="52"/><circle class="pr" id="pr" cx="60" cy="60" r="52"/></svg>
<button class="jb" id="jb"><b id="jc">0</b><small>Hare Krishna</small></button></div>
<div class="mala" id="ml"></div>
</div>

<div class="btns"><a class="home" href="index.html">🏠 Home Chalo</a><button class="retry" id="rt">🔄 Dobara Try</button></div>
<div class="foot">🪷 Hare Krishna • Page jaldi aayega, Krishna ki kripa se</div>
</div>
<div class="toast" id="ts"></div>
<script>
(function(){
var $=function(i){return document.getElementById(i)};
try{if(localStorage.getItem("theme")==="dark")document.body.setAttribute("data-theme","dark")}catch(e){}
var night=document.body.getAttribute("data-theme")==="dark";
var reduce=false;try{reduce=matchMedia("(prefers-reduced-motion: reduce)").matches}catch(e){}

/* ================= text rotators + japa counter ================= */
var M=["Prabhu, yahan abhi eent lag rahi hai 🧱","Mistri prasadam kha raha hai 🍛 (laddu pe laddu)","Developer ne code likha, bug ne hasi uda di 🐛","Sudarshan Chakra se debug chal raha hai 🌀","Page ka GPS kaam nahi kar raha 📍","Dome crane se latka hai, bas utar raha hai ⛪","Krishna bole: thoda sabr karo, sab theek hoga 🦚","Page kirtan me chala gaya, Haribol! 🥁","Server bola: Ekadashi hai, kal aana 😴","Maakhan chura ke page chhup gaya hai 🧈","Gau mata raasta rok ke khadi hain 🐄"];
var i=0,m=$("m");m.textContent=M[0];
setInterval(function(){m.style.opacity=0;setTimeout(function(){i=(i+1)%M.length;m.textContent=M[i];m.style.opacity=.92},400)},3200);
var P=["Loading... 99% (itna hi rehta hai 😅)","Loading... 99.9% (bas ho gaya, sach me)","Loading... 99.99% (ab to sharam aani chahiye)"],pi=0;
setInterval(function(){pi=(pi+1)%P.length;$("pt").textContent=P[pi]},4200);
function toast(t){var e=$("ts");e.textContent=t;e.classList.add("on");setTimeout(function(){e.classList.remove("on")},3500)}
var cnt=0,malas=0,C=326.7;
try{malas=+localStorage.getItem("kc_malas")||0}catch(e){}
function ml(){$("ml").textContent=malas?("Total malas poori: "+malas+" 🙏"):"Pehli mala shuru karo 🙏"}
ml();
$("jb").addEventListener("click",function(ev){
cnt++;$("jc").textContent=cnt;$("pr").style.strokeDashoffset=C-C*cnt/108;
try{navigator.vibrate&&navigator.vibrate(12)}catch(e){}
var f=document.createElement("div");f.className="float";f.textContent=["🪷","🦚","✨","📿"][cnt%4];
f.style.left=(ev.clientX||innerWidth/2)-8+"px";f.style.top=(ev.clientY||innerHeight/2)-20+"px";document.body.appendChild(f);setTimeout(function(){f.remove()},1100);
if(cnt>=108){cnt=0;malas++;try{localStorage.setItem("kc_malas",String(malas))}catch(e){}
setTimeout(function(){$("jc").textContent=0;$("pr").style.strokeDashoffset=C},500);ml();toast("Ek mala poori! Hare Krishna 🙏🪷")}});
$("rt").onclick=function(){location.reload()};

/* ================= CANVAS WORLD ================= */
var cv=$("cv"),cx=cv.getContext("2d"),W=320,H=240,S=1;
var GY=196,Y0=GY-4,TX=150,TW=72,N=72,PX=186,PY=50,R0=46,R1=94;
function size(){var w=cv.parentNode.clientWidth||320,d=Math.min(window.devicePixelRatio||1,2);cv.style.height=(w*H/W)+"px";cv.width=Math.round(w*d);cv.height=Math.round(w*H/W*d);S=cv.width/W}
size();
var t=0,p=reduce?60:0,phase="build",pt=0,rope=R0,hitT=0,eatT=9,eating=0,jy=0,jv=0,sq=0,blink=0,blinkT=2,bub=null,sayT=3,mx=240,my=120,hint=true,cowX=-30,sweatT=2,said=0,ps=[];
var STARS=[],k;for(k=0;k<38;k++)STARS.push({x:Math.random()*W,y:Math.random()*130,r:Math.random()*1.1+.3,ph:Math.random()*6});
var CLOUDS=[{x:20,y:30,s:1,v:5},{x:150,y:62,s:.7,v:3},{x:260,y:22,s:.8,v:4}];
var LINES=["Hare Krishna! 🙏","Eent tedhi hai prabhu 😅","Jai Shri Krishna 🦚","Thoda sabr, prabhu 🙏","Target: ek mandir 🛕","Haribol! 🥁","404? Krishna ki leela 😌"];
function rnd(a,b){return a+Math.random()*(b-a)}
function ease(x){return x<.5?2*x*x:1-Math.pow(-2*x+2,2)/2}
function circ(x,y,r){cx.beginPath();cx.arc(x,y,r,0,6.2832);cx.fill()}
function ell(x,y,a,b){cx.beginPath();cx.ellipse(x,y,a,b,0,0,6.2832);cx.fill()}
function line(a,b,c,d){cx.beginPath();cx.moveTo(a,b);cx.lineTo(c,d);cx.stroke()}
function rrp(x,y,w,h,r){cx.beginPath();cx.moveTo(x+r,y);cx.arcTo(x+w,y,x+w,y+h,r);cx.arcTo(x+w,y+h,x,y+h,r);cx.arcTo(x,y+h,x,y,r);cx.arcTo(x,y,x+w,y,r);cx.closePath()}
function say(s,d){bub={t:s,l:0,m:d||2.6}}
function spawn(o){if(ps.length<280)ps.push(o)}
function spark(x,y,n){for(var a=0;a<n;a++)spawn({k:"s",x:x,y:y,vx:rnd(-60,60),vy:rnd(-90,-20),l:0,m:rnd(.25,.5),c:["#FFEB3B","#FFA000","#fff"][a%3]})}
function dust(x,y,n){for(var a=0;a<n;a++)spawn({k:"d",x:x+rnd(-4,4),y:y,vx:rnd(-14,14),vy:rnd(-12,-2),l:0,m:rnd(.5,.9)})}
function petals(x,y,n){for(var a=0;a<n;a++)spawn({k:"p",x:x+rnd(-8,8),y:y+rnd(-6,6),vx:rnd(-10,10),vy:rnd(14,26),l:0,m:rnd(2.5,4),ph:rnd(0,6),r:0,c:["#FF9800","#FFC107","#F06292","#FFE082"][a%4]})}
function conf(x,y,n){for(var a=0;a<n;a++)spawn({k:"c",x:x,y:y,vx:rnd(-90,90),vy:rnd(-150,-40),l:0,m:rnd(1.4,2.6),r:rnd(0,6),vr:rnd(-8,8),c:["#FF9800","#FFC107","#E91E63","#4CAF50","#fff","#29B6F6"][a%6]})}
function tap(){
if(jv===0&&jy===0)jv=-230;
say(LINES[Math.floor(Math.random()*LINES.length)],2.4);
if(phase==="build"&&!eating)p=Math.min(N,p+3);
petals(mx,my,7);
}
function pos(e){var r=cv.getBoundingClientRect();mx=(e.clientX-r.left)/r.width*W;my=(e.clientY-r.top)/r.height*H}
cv.addEventListener("pointermove",pos);
cv.addEventListener("pointerdown",function(e){pos(e);hint=false;tap()});
window.addEventListener("resize",function(){size();if(reduce)frame()});

function update(dt){
/* worker blink */
blinkT-=dt;if(blinkT<=0){blink=.13;blinkT=rnd(2,5)}if(blink>0)blink-=dt;
/* jump physics */
if(jv!==0||jy<0){jv+=800*dt;jy+=jv*dt;if(jy>=0){jy=0;jv=0;sq=.22;dust(80,GY,6)}}
if(sq>0)sq=Math.max(0,sq-dt*1.4);
/* speech */
if(bub){bub.l+=dt;if(bub.l>=bub.m)bub=null}
sayT-=dt;if(sayT<=0&&!bub){say(LINES[Math.floor(Math.random()*LINES.length)],2.4);sayT=rnd(6,9)}
/* cow + clouds */
cowX+=6*dt;if(cowX>W+40)cowX=-40;
/* phases */
if(phase==="build"){
if(!eating){eatT-=dt;if(eatT<=0){eating=4.5;say("Prasadam time 🍬",3)}}
else{eating-=dt;if(eating<=0){eating=0;eatT=rnd(14,20)}}
if(!eating){hitT+=dt;if(hitT>=.6){hitT-=.6;p=Math.min(N,p+1.5);spark(108,177,7);dust(108,178,2);if(p>=N){phase="dome";pt=0;said=0;say("Dome utar raha hai... 😬",2.6)}}
sweatT-=dt;if(sweatT<=0){sweatT=rnd(2,4);spawn({k:"w",x:86,y:GY-56,l:0,m:1.1})}}
}else if(phase==="dome"){
pt+=dt;var a=Math.min(1,pt/3.2);rope=R0+(R1-R0)*ease(a);
if(a>=1){phase="party";pt=0;said=0;conf(186,GY-70,60);petals(186,GY-70,10);say("Mandir ban gaya! 🛕",3)}
}else if(phase==="party"){
pt+=dt;rope=R1;if(jv===0&&jy===0&&Math.sin(pt*7)>.98)jv=-190;
if(pt>3&&said===0){said=1;say("Par page nahi mila 😅",2.6)}
if(pt>6){phase="reset";pt=0;said=0}
}else{
pt+=dt;var b=Math.min(1,pt/2.4);rope=R1-(R1-R0)*ease(b);
if(pt>.8){if(!said){said=1;say("Arre! Gir gaya 😭",2.2)}
var before=Math.ceil(p);p=Math.max(0,p-70*dt);var after=Math.ceil(p);
for(var q=after;q<before;q++){var row=Math.floor(q/9),col=q%9;if(row<4&&col>=3&&col<=5)continue;
spawn({k:"b",x:TX+col*8+4,y:Y0-(row+1)*6+3,vx:rnd(-50,50),vy:rnd(-60,0),l:0,m:1.3,r:0,vr:rnd(-6,6),c:["#D84315","#E64A19","#BF360C","#F4511E"][(q*7)%4]});
if(q%4===0)dust(TX+col*8+4,Y0-(row+1)*6+3,1)}}
if(p<=0&&b>=1){phase="build";pt=0;hitT=0;eatT=rnd(8,12)}
}
/* particles */
for(var i2=ps.length-1;i2>=0;i2--){var o=ps[i2];o.l+=dt;if(o.l>=o.m){ps.splice(i2,1);continue}
if(o.k==="s"||o.k==="c"||o.k==="b"){o.vy+=(o.k==="s"?200:o.k==="c"?120:520)*dt;o.x+=o.vx*dt;o.y+=o.vy*dt;o.r=(o.r||0)+(o.vr||0)*dt;if(o.k==="b"&&o.y>GY-3){o.y=GY-3;o.vy*=-.3;o.vx*=.6}}
else if(o.k==="p"){o.x+=(Math.sin(t*2+o.ph)*14+o.vx)*dt;o.y+=o.vy*dt;o.r+=dt*2}
else if(o.k==="d"){o.x+=o.vx*dt;o.y+=o.vy*dt}
else if(o.k==="w"){o.y+=14*dt}}
}

/* ---------- drawing ---------- */
function bg(){
var g=cx.createLinearGradient(0,0,0,GY);
if(night){g.addColorStop(0,"#120a2a");g.addColorStop(1,"#4a2560")}else{g.addColorStop(0,"#FFAB40");g.addColorStop(.6,"#FFD180");g.addColorStop(1,"#FFF3E0")}
cx.fillStyle=g;cx.fillRect(0,0,W,H);
var a;
if(night){for(a=0;a<STARS.length;a++){var s=STARS[a];cx.globalAlpha=.4+.6*Math.abs(Math.sin(t*1.5+s.ph));cx.fillStyle="#fff";circ(s.x,s.y,s.r)}cx.globalAlpha=1;
cx.fillStyle="#FFF8E1";circ(250,52,15);cx.fillStyle="#2a1650";circ(256,48,13)}
else{var rg=cx.createRadialGradient(250,52,4,250,52,46);rg.addColorStop(0,"rgba(255,235,59,.9)");rg.addColorStop(1,"rgba(255,235,59,0)");cx.fillStyle=rg;circ(250,52,46);
cx.strokeStyle="rgba(255,213,79,.55)";cx.lineWidth=2;cx.lineCap="round";
for(a=0;a<12;a++){var an=a*.5236+t*.25;line(250+Math.cos(an)*25,52+Math.sin(an)*25,250+Math.cos(an)*(31+(a%2)*5),52+Math.sin(an)*(31+(a%2)*5))}
cx.fillStyle="#FFD54F";circ(250,52,19)}
for(a=0;a<CLOUDS.length;a++){var c=CLOUDS[a],x=(c.x+t*c.v)%(W+80)-40;cx.fillStyle=night?"rgba(180,160,220,.22)":"rgba(255,255,255,.85)";
ell(x,c.y,18*c.s,7*c.s);ell(x+12*c.s,c.y-5*c.s,12*c.s,7*c.s);ell(x-12*c.s,c.y-3*c.s,10*c.s,6*c.s)}
for(var l=0;l<2;l++){cx.fillStyle=l?(night?"#35205a":"#EF8A3F"):(night?"#2a1747":"#F4A261");cx.globalAlpha=l?.8:.6;cx.beginPath();cx.moveTo(0,GY);
for(var xx=0;xx<=W;xx+=8)cx.lineTo(xx,GY-26-l*0-Math.sin(xx*.021+1+l*2)*10-Math.sin(xx*.05+l)*4-l*(-6));
cx.lineTo(W,GY);cx.closePath();cx.fill()}
cx.globalAlpha=1;
cx.fillStyle=night?"#2d2133":"#6D4C41";cx.fillRect(0,GY,W,H-GY);
cx.fillStyle=night?"#4a3a5a":"#8D6E63";cx.fillRect(0,GY,W,5);
}
function crane(){
cx.fillStyle="#546E7A";cx.fillRect(266,PY-4,8,GY-PY+4);
cx.strokeStyle="#90A4AE";cx.lineWidth=1.2;
for(var yy=PY;yy<GY-8;yy+=16){line(266,yy,274,yy+16);line(274,yy,266,yy+16)}
cx.fillStyle="#FFB300";cx.fillRect(140,PY-9,140,5);
cx.fillStyle="#F57C00";cx.fillRect(262,PY-16,16,10);
cx.fillStyle="#455A64";cx.fillRect(278,PY-9,16,11);
cx.strokeStyle="#78909C";cx.lineWidth=1;line(270,PY-28,142,PY-9);line(270,PY-28,292,PY-9);line(270,PY-28,270,PY-16);
cx.fillStyle=Math.sin(t*4)>0?"#F44336":"#7f1d1d";circ(270,PY-30,2.3);
cx.fillStyle="#37474F";cx.fillRect(PX-6,PY-5,12,6);
}
function temple(){
var i,row,col,a,x,y;
for(i=0;i<N;i++){row=Math.floor(i/9);col=i%9;if(row<4&&col>=3&&col<=5)continue;a=Math.max(0,Math.min(1,p-i));if(a<=0)continue;
x=TX+col*8;y=Y0-(row+1)*6-(1-a)*8;cx.globalAlpha=a;cx.fillStyle=["#D84315","#E64A19","#BF360C","#F4511E"][(i*7)%4];cx.fillRect(x,y,7.4,5.4);cx.fillStyle="rgba(255,255,255,.18)";cx.fillRect(x,y,7.4,1.2)}
cx.globalAlpha=1;
if(p>=N-.01){cx.fillStyle="#FFC107";cx.fillRect(TX-3,Y0-51,TW+6,3)}
var da=Math.min(1,p/36),x0=TX+24;cx.globalAlpha=da;
cx.fillStyle="#3E2723";cx.beginPath();cx.moveTo(x0,Y0);cx.lineTo(x0,Y0-18);cx.arc(x0+12,Y0-18,12,Math.PI,0);cx.lineTo(x0+24,Y0);cx.closePath();cx.fill();
var fl=.55+.25*Math.sin(t*9);cx.fillStyle="rgba(255,193,7,"+(night?fl:fl*.5)+")";ell(x0+12,Y0-8,5,7);
cx.globalAlpha=1;
cx.fillStyle="#8D3A12";cx.fillRect(TX-6,Y0,TW+12,4);
if(night){var xs=[TX-12,TX+TW+12];for(var d=0;d<2;d++){var fx=xs[d],fr=3+Math.sin(t*11+d*2)*.7;var gl=cx.createRadialGradient(fx,GY-8,1,fx,GY-8,16);gl.addColorStop(0,"rgba(255,193,7,.5)");gl.addColorStop(1,"rgba(255,193,7,0)");cx.fillStyle=gl;circ(fx,GY-8,16);
cx.fillStyle="#8D4B2A";ell(fx,GY-1,5,2.4);cx.fillStyle="#FFEB3B";cx.beginPath();cx.moveTo(fx,GY-12);cx.quadraticCurveTo(fx+fr,GY-6,fx,GY-3);cx.quadraticCurveTo(fx-fr,GY-6,fx,GY-12);cx.fill()}}
}
function dome(){
var landed=phase==="party";
var amp=phase==="build"?1:phase==="dome"?1-Math.min(1,pt/3.2):landed?0:ease(Math.min(1,pt/2.4));
var ang=Math.sin(t*2)*.07*amp;
cx.save();cx.translate(PX,PY);cx.rotate(ang);
cx.strokeStyle="#37474F";cx.lineWidth=1.6;line(0,0,-28,rope);line(0,0,28,rope);
cx.translate(0,rope);
var g=cx.createRadialGradient(-10,-18,4,0,-8,42);g.addColorStop(0,"#FFF59D");g.addColorStop(.5,"#FFC107");g.addColorStop(1,"#E65100");
cx.fillStyle=g;cx.beginPath();cx.ellipse(0,0,36,30,0,Math.PI,0);cx.closePath();cx.fill();
cx.strokeStyle="#E65100";cx.lineWidth=1.4;cx.stroke();
cx.strokeStyle="rgba(255,255,255,.4)";cx.lineWidth=1;cx.beginPath();cx.ellipse(0,0,22,30,0,Math.PI,0);cx.stroke();cx.beginPath();cx.ellipse(0,0,10,30,0,Math.PI,0);cx.stroke();
cx.fillStyle="#E65100";cx.fillRect(-38,-2,76,4);
cx.strokeStyle="#E65100";cx.lineWidth=2.5;line(0,-30,0,-37);cx.fillStyle="#FFC107";ell(0,-41,3.2,4.6);
if(landed){cx.strokeStyle="#5D4037";cx.lineWidth=1.5;line(0,-45,0,-62);var w1=Math.sin(t*6)*3;
cx.fillStyle="#FF6F00";cx.beginPath();cx.moveTo(0,-62);cx.quadraticCurveTo(10,-62+w1,20,-57+Math.sin(t*6+1)*2);cx.quadraticCurveTo(10,-52+Math.sin(t*6+2)*2,0,-51);cx.closePath();cx.fill();cx.fillStyle="#FFE082";circ(6,-57,1.6)}
cx.restore();
}
function sign(){
cx.fillStyle="#6D4C41";cx.fillRect(32,166,4,30);
rrp(6,140,56,26,4);cx.fillStyle="#FFE082";cx.fill();cx.strokeStyle="#6D4C41";cx.lineWidth=1.5;cx.stroke();
var a=eating?["PRASAD","BREAK 🍛"]:phase==="party"?["MANDIR","BAN GAYA 🛕"]:["KAAM CHAL","RAHA HAI 🚧"];
cx.fillStyle="#4E2A00";cx.font="800 8px Poppins,'Noto Sans Devanagari',system-ui,sans-serif";cx.textAlign="center";cx.fillText(a[0],34,151);cx.fillText(a[1],34,162);cx.textAlign="left";
cx.fillStyle="#8D6E63";cx.fillRect(98,178,28,18);cx.strokeStyle="#5D4037";cx.lineWidth=1;line(98,184,126,184);line(98,190,126,190);cx.strokeRect(98,178,28,18);
cx.fillStyle="#D84315";cx.fillRect(104,173,14,5);
}
function limb(sx,sy,a,len){var ex=sx+Math.cos(a)*len,ey=sy+Math.sin(a)*len;cx.strokeStyle="#FB8C00";cx.lineWidth=5;cx.lineCap="round";line(sx,sy,ex,ey);cx.fillStyle="#F3B27A";circ(ex,ey,2.7);return[ex,ey]}
function worker(){
var x=80,y=GY+jy,lx=Math.max(-1,Math.min(1,(mx-x)/50)),ly=Math.max(-1,Math.min(1,(my-(y-50))/45));
if(phase==="dome"||phase==="reset"){lx=.7;ly=-.8}
var talk=bub&&bub.l<bub.m,chew=eating>0,party=phase==="party"||jy<-2;
var mo=chew?.5+.5*Math.sin(t*14):talk?.5+.5*Math.sin(t*17):party?1:0;
cx.fillStyle="rgba(0,0,0,.22)";ell(x,GY+1,13*(1+jy/160),3);
cx.save();cx.translate(x,y);cx.scale(1+sq,1-sq);
cx.fillStyle="#E0A070";ell(-6,-1,4,2);ell(6,-1,4,2);
/* left arm (behind) */
limb(-8,-36,party?-2.2+Math.sin(t*10+1)*.2:1.75+Math.sin(t*3)*.07,12);
/* dhoti */
cx.fillStyle="#fff";cx.beginPath();cx.moveTo(-9,-24);cx.lineTo(9,-24);cx.lineTo(12,-2);cx.lineTo(-12,-2);cx.closePath();cx.fill();
cx.strokeStyle="rgba(0,0,0,.18)";cx.lineWidth=.8;line(-3,-24,-4,-3);line(3,-24,4,-3);line(0,-24,0,-4);
/* kurta */
cx.fillStyle="#FB8C00";rrp(-9,-41,18,19,5);cx.fill();
cx.strokeStyle="#E65100";cx.lineWidth=1;line(0,-41,0,-33);
/* tulsi mala */
cx.fillStyle="#2E7D32";for(var b=0;b<7;b++){var u=(b-3)/3;circ(-6+b*2,-38+4*(1-u*u),1.3)}
/* head */
var hb=Math.sin(t*4)*.6,hy=-50+hb,fx=lx*2.2,fy=ly*1.1;
cx.fillStyle="#E8A06A";circ(-11,hy+1,2.4);circ(11,hy+1,2.4);
cx.fillStyle="#F3B27A";circ(0,hy,11);
cx.fillStyle="rgba(255,110,110,.35)";circ(fx-7,hy+5,2.4);circ(fx+7,hy+5,2.4);
/* vaishnava tilak */
cx.strokeStyle="#fff";cx.lineWidth=1.7;cx.lineCap="round";line(fx-3,hy-7,fx-1.4,hy-2.5);line(fx+3,hy-7,fx+1.4,hy-2.5);
cx.fillStyle="#2E7D32";circ(fx,hy-2.2,1.1);
/* eyes */
var bl=blink>0?.12:1;
for(var s=-1;s<=1;s+=2){var ex=fx+s*4.2,ey=hy+1+fy;cx.save();cx.translate(ex,ey);cx.scale(1,bl);cx.fillStyle="#fff";circ(0,0,3.1);cx.fillStyle="#222";circ(lx*1.2,ly*1,1.6);cx.fillStyle="#fff";circ(lx*1.2+.5,ly-.5,.5);cx.restore();
cx.strokeStyle="#5D3A1A";cx.lineWidth=1.1;line(ex-2.4,ey-4.4-(mo>.4?1.2:0),ex+2.4,ey-4.6-(mo>.4?1.2:0))}
/* mouth */
if(mo>.05){cx.fillStyle="#7a2d1a";ell(fx*.8,hy+7,2.4,1.1+mo*1.7)}
else{cx.strokeStyle="#7a3b1e";cx.lineWidth=1.4;cx.beginPath();cx.arc(fx*.8,hy+4,3.6,.15*Math.PI,.85*Math.PI);cx.stroke()}
/* helmet */
cx.fillStyle="#FFC107";cx.beginPath();cx.arc(0,hy-8,12,Math.PI,0);cx.closePath();cx.fill();
cx.fillStyle="#FFE082";cx.fillRect(-1.5,hy-20,3,12);
cx.fillStyle="#FFA000";rrp(-14,hy-9,28,3.5,1.7);cx.fill();
/* shikha poking out of the helmet */
var sw=Math.sin(t*3);cx.strokeStyle="#222";cx.lineWidth=2.4;cx.beginPath();cx.moveTo(0,hy-20);cx.quadraticCurveTo(-3+sw*2,hy-26,-1+sw*3,hy-31);cx.stroke();
cx.fillStyle="#FF9800";circ(-1+sw*3,hy-32,2);
/* right arm + hammer / laddu */
var ra;
if(chew)ra=-2.4+Math.sin(t*14)*.05;
else if(party)ra=-1.25+Math.sin(t*10)*.2;
else if(phase==="build"){var ph=hitT/.6;ra=ph<.15?.78-.48*(ph/.15):ph<.75?.3-1.45*((ph-.15)/.6):-1.15+1.93*Math.pow((ph-.75)/.25,2)}
else ra=1.1;
var h=limb(7,-36,ra,12);
if(chew){cx.fillStyle="#FF9800";circ(h[0],h[1],3.4);cx.fillStyle="#FFCC80";circ(h[0]-1,h[1]-1,1.1)}
else{var hx=h[0]+Math.cos(ra)*14,hy2=h[1]+Math.sin(ra)*14;cx.strokeStyle="#795548";cx.lineWidth=2.6;line(h[0],h[1],hx,hy2);
cx.save();cx.translate(hx,hy2);cx.rotate(ra);cx.fillStyle="#607D8B";cx.fillRect(-2,-4.5,6,9);cx.restore()}
cx.restore();
}
function bubble(){
if(!bub)return;var a=Math.min(1,bub.l*6,(bub.m-bub.l)*6);if(a<=0)return;
cx.save();cx.globalAlpha=a;cx.font="700 8.5px Poppins,'Noto Sans Devanagari',system-ui,sans-serif";
var w=cx.measureText(bub.t).width+14,h=17,bx=Math.max(4,Math.min(W-w-4,88-w/2)),bottom=GY+jy-96,by=bottom-h;
rrp(bx,by,w,h,8);cx.fillStyle="#fff";cx.fill();cx.strokeStyle="#4E2A00";cx.lineWidth=1;cx.stroke();
cx.fillStyle="#fff";cx.beginPath();cx.moveTo(78,bottom-.5);cx.lineTo(84,bottom+6);cx.lineTo(90,bottom-.5);cx.fill();
cx.fillStyle="#4E2A00";cx.textBaseline="middle";cx.fillText(bub.t,bx+7,by+h/2+.5);cx.restore();
}
function cow(){
var y=222,sc=.85,ph=t*3.2;
cx.save();cx.translate(cowX,y);cx.scale(sc,sc);
cx.fillStyle="rgba(0,0,0,.2)";ell(0,2,20,3);
var lg=[-11,-6,7,12],a;cx.lineCap="round";
for(a=0;a<4;a++){var sw=Math.sin(ph+a*1.6)*3;cx.strokeStyle="#EEE";cx.lineWidth=3.2;line(lg[a],-8,lg[a]+sw,-1);cx.fillStyle="#5D4037";circ(lg[a]+sw,0,1.6)}
cx.strokeStyle="#F5F5F5";cx.lineWidth=2;cx.beginPath();cx.moveTo(-16,-18);cx.quadraticCurveTo(-24,-14,-22+Math.sin(t*5)*3,-6);cx.stroke();cx.fillStyle="#5D4037";circ(-22+Math.sin(t*5)*3,-5,2);
cx.fillStyle="#fff";ell(0,-15,17,9.5);
cx.fillStyle="#8D6E63";ell(-6,-18,5,3.5);ell(7,-12,4,3);
cx.fillStyle="#F8BBD0";ell(-6,-6,3,2);
var hd=3*Math.max(0,Math.sin(t*.7));
cx.fillStyle="#fff";ell(14,-19+hd*.5,6,6);ell(19,-20+hd,6,5.2);
cx.fillStyle="#F8BBD0";ell(24,-18+hd,3.2,2.6);
cx.fillStyle="#222";circ(20,-22+hd,.9);
cx.strokeStyle="#D7CCC8";cx.lineWidth=1.6;line(17,-25+hd,15,-29+hd);
cx.fillStyle="#8D6E63";ell(15,-23+hd,3,1.6);
for(a=0;a<5;a++){var an=.4+a*.28;cx.fillStyle=a%2?"#FFC107":"#FF9800";circ(11+6*Math.cos(an),-18+hd*.6+6*Math.sin(an),1.7)}
cx.restore();
}
function particles(){
for(var i=0;i<ps.length;i++){var o=ps[i],f=1-o.l/o.m;
if(o.k==="s"){cx.globalAlpha=f;cx.fillStyle=o.c;cx.fillRect(o.x,o.y,1.8,1.8)}
else if(o.k==="d"){cx.globalAlpha=.5*f;cx.fillStyle=night?"#9575CD":"#FFE0B2";circ(o.x,o.y,2+o.l*8)}
else if(o.k==="w"){cx.globalAlpha=f;cx.fillStyle="#81D4FA";circ(o.x,o.y,1.3)}
else{cx.save();cx.globalAlpha=Math.min(1,f*2);cx.translate(o.x,o.y);cx.rotate(o.r||0);
if(o.k==="p"){cx.fillStyle=o.c;ell(0,0,2.6,1.4)}else if(o.k==="c"){cx.fillStyle=o.c;cx.fillRect(-1.5,-1,3,2)}else{cx.fillStyle=o.c;cx.fillRect(-3.7,-2.7,7.4,5.4)}
cx.restore()}}
cx.globalAlpha=1;
}
function frame(){
cx.setTransform(S,0,0,S,0,0);cx.clearRect(0,0,W,H);cx.textBaseline="alphabetic";
bg();crane();temple();dome();sign();worker();cow();particles();bubble();
if(hint){cx.globalAlpha=.8;cx.fillStyle="#fff";cx.font="700 8px Poppins,'Noto Sans Devanagari',system-ui,sans-serif";cx.textAlign="center";cx.fillText("👆 Tap karo, mistri prabhu kuch bolenge",W/2,H-6);cx.textAlign="left";cx.globalAlpha=1}
}
var last=0;
function loop(ts){var dt=Math.min(.05,(ts-last)/1000||0);last=ts;t+=dt;update(dt);frame();requestAnimationFrame(loop)}
if(reduce){frame()}else{requestAnimationFrame(loop)}
})();
</script>
</body></html>
